{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PowerTimer",
  "version": "0.8.0",
  "identifier": "com.lostheaven.powertimermini",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "PowerTimer",
        "width": 1200,
        "height": 680,
        "minWidth": 1200,
        "minHeight": 680,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "backgroundColor": "#090a0c",
        "center": true,
        "visible": true,
        "shadow": false
      },
      {
        "label": "tray-menu",
        "title": "PowerTimer — Меню",
        "url": "tray.html",
        "width": 340,
        "height": 242,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "shadow": false,
        "visible": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "focus": false,
        "backgroundColor": "#0a0b0d"
      }
    ],
    "security": {
      "csp": "default-src 'self' asset:; img-src 'self' asset:; style-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
